+@pytest.mark.parametrize("reserve,eligible", [(0.0, True), (60.0, False)])
+async def test_decision_nets_the_reserve_against_the_threshold(paper, monkeypatch, reserve, eligible):
+    service = paper
+    target = plan(service, reserve)
+    monkeypatch.setattr(service.optimizer, "solve", lambda *a, **k: target)
+    monkeypatch.setattr(
+        service.gate,
+        "validate",
+        lambda *a, **k: service.gate.engine.evaluate(*a[:4]).model_copy(
+            update={"passed": True, "reasons": ()}
+        ),
+    )
+    service.force_optimize = True
+    await service.optimize()
+    record = service.store.records("decision", service.manifest.account, 1)[0]
+    assert record["gross_improvement"] == pytest.approx(150)
+    assert record["reversal_reserve"] == pytest.approx(reserve)
+    assert record["improvement"] == pytest.approx(150 - reserve)
+    assert record["trade_eligible"] is eligible
+    assert (service.pending_target is not None) is eligible
+    if not eligible:
+        assert any("spread reserve" in reason for reason in record["blocking_reasons"])
