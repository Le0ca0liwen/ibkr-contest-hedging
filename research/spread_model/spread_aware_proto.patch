+def test_plan_slices_keep_path_headroom_below_caps(manifest, store):
+    from types import SimpleNamespace
+
+    from hedge.execution import PATH_DELTA_BAND, PATH_GROSS_BAND, ExecutionManager
+    from hedge.optimizer import DELTA_HEADROOM
+    from hedge.risk import RiskEngine
+
+    # Path bands sit outside the optimizer's own target headroom.
+    assert GROSS_HEADROOM < PATH_GROSS_BAND < 1 and DELTA_HEADROOM < PATH_DELTA_BAND < 1
+    gate = SimpleNamespace(engine=RiskEngine(manifest))
+    manager = ExecutionManager(manifest, store, None, gate)
+    snapshot = SimpleNamespace(nav=1_000_000)
+    delta_cap = manifest.risk.residual_delta * 1_000_000
+    gross_cap = manifest.risk.gross_notional * 1_000_000
+
+    def risk(delta, gross):
+        return SimpleNamespace(metrics={"delta:BA": delta, "gross_notional": gross})
+
+    # Raising |delta| into the last 5% below the cap is refused; reducing it or staying lower is not.
+    assert manager._crowds_cap(snapshot, risk(0.90 * delta_cap, 0), risk(0.97 * delta_cap, 0), "BA")
+    assert not manager._crowds_cap(snapshot, risk(0.97 * delta_cap, 0), risk(0.96 * delta_cap, 0), "BA")
+    assert not manager._crowds_cap(snapshot, risk(0.5 * delta_cap, 0), risk(0.9 * delta_cap, 0), "BA")
+    # Same for gross notional above 98% of its cap.
+    assert manager._crowds_cap(snapshot, risk(0, 0.97 * gross_cap), risk(0, 0.99 * gross_cap), "BA")
+    assert not manager._crowds_cap(snapshot, risk(0, 0.99 * gross_cap), risk(0, 0.985 * gross_cap), "BA")
+
