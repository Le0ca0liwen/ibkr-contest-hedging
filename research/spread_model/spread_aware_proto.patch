+def _unit_reserve(manifest, contract, quote, signed):
+    """Per-unit decision reserve: policy multiple x the modeled one-way crossing cost of one unit."""
+    rho = (
+        manifest.policy.option_reversal_reserve
+        if contract.kind == "OPT"
+        else manifest.policy.stock_reversal_reserve
+    )
+    if not rho:
+        return 0.0
+    available = quote.ask_size if signed > 0 else quote.bid_size
+    size = max(
+        1,
+        min(
+            manifest.execution.option_slice if contract.kind == "OPT" else manifest.execution.stock_slice,
+            available,
+        ),
+    )
+    rate = manifest.policy.commission_option if contract.kind == "OPT" else manifest.policy.commission_share
+    fee = max(manifest.policy.minimum_commission, rate * size) / size
+    spread = (quote.ask - quote.bid) * (0.5 + manifest.policy.slippage_spread_fraction) * contract.multiplier
+    return rho * (spread + fee)
+
+
