+def test_cap_hysteresis_targets_inside_the_unchanged_gross_cap(manifest, snapshot, quotes, now):
+    # A tight cap that binds the original solution.
+    tight = manifest.model_copy(update={"risk": manifest.risk.model_copy(update={"gross_notional": 0.2})})
+    tight = with_policy(tight, burn_surplus=False)
+    cap = tight.risk.gross_notional * float(min(tight.initial_nav, snapshot.nav))
+    scenarios = ScenarioEngine(tight).build(snapshot, quotes, now)
+    original = HedgeOptimizer(tight).solve(snapshot, quotes, scenarios, tight.initial_nav)
+    assert original.status == "OPTIMAL" and _gross(tight, original.quantities, quotes) > 0.95 * cap
+    banded = HedgeOptimizer(with_policy(tight, cap_hysteresis=True)).solve(
+        snapshot, quotes, scenarios, tight.initial_nav
+    )
+    assert banded.status == "OPTIMAL"
+    assert _gross(tight, banded.quantities, quotes) <= GROSS_HEADROOM * cap + 1e-6
+    assert with_policy(tight, cap_hysteresis=True).risk.gross_notional == 0.2  # the limit is unchanged
