+def plan(service, reserve, gross=150.0):
+    held = service.broker.snapshot().quantities()
+    return Target(
+        quantities={**held, 103: held.get(103, 0) - 1},
+        expected_score=1000 - gross,
+        current_score=1000,
+        uncertainty=0,
+        status="OPTIMAL",
+        snapshot_id="s",
+        scenario_id="x",
+        config_hash="h",
+        reversal_reserve=reserve,
+    )
