diff -ruN -x __pycache__ -x .ruff_cache -x .pytest_cache base/tests/test_spread_reserve.py proto/tests/test_spread_reserve.py
--- base/tests/test_spread_reserve.py	1970-01-01 00:00:00.000000000 +0000
+++ proto/tests/test_spread_reserve.py	2026-10-21 22:07:27.907033376 +0000
@@ -0,0 +1,251 @@
+"""Spread-aware decision rule: decision-only reversal reserve and passive option repricing."""
+
+import asyncio
+
+import numpy as np
+import pytest
+
+from hedge.models import Target
+from hedge.optimizer import GROSS_HEADROOM, HedgeOptimizer, execution_cost, reversal_reserve
+from hedge.scenarios import ScenarioEngine, ScenarioSet
+from hedge.service import TradingService
+
+
+def with_policy(manifest, **values):
+    return manifest.model_copy(update={"policy": manifest.policy.model_copy(update=values)})
+
+
+def hedge_fixture(manifest):
+    """Two scenarios; each contract of 103 sold removes exactly $10 of expected |closing gap|."""
+    ids = (101, 102, 103)
+    changes = np.array([[100.0, 0.0, 10.0], [-100.0, 0.0, -10.0]])
+    return ScenarioSet(ids, changes, np.array([0.5, 0.5]), np.zeros((1, 3)), None, 0.1, "fixture", "band")
+
+
+def test_default_reserve_is_zero_and_changes_nothing(manifest, snapshot, quotes, now):
+    assert manifest.policy.option_reversal_reserve == 0 == manifest.policy.stock_reversal_reserve
+    scenarios = ScenarioEngine(manifest).build(snapshot, quotes, now)
+    result = HedgeOptimizer(manifest).solve(snapshot, quotes, scenarios, manifest.initial_nav)
+    assert result.status == "OPTIMAL"
+    assert result.reversal_reserve == 0 and result.components["reversal_reserve"] == 0
+
+
+def test_reserve_is_policy_multiple_of_each_units_one_way_crossing_cost(manifest, quotes):
+    m = with_policy(manifest, option_reversal_reserve=1.5, stock_reversal_reserve=0.5)
+    option, stock = quotes[103], quotes[10]
+    per_contract = (option.ask - option.bid) * 0.6 * 100 + 1.0  # spread share + $1 minimum fee per slice
+    per_share = (stock.ask - stock.bid) * 0.6 + 1.0 / 100  # $1 per 100-share slice
+    assert reversal_reserve(m, quotes, [103], [-3]) == pytest.approx(1.5 * 3 * per_contract)
+    assert reversal_reserve(m, quotes, [10], [200]) == pytest.approx(0.5 * 200 * per_share)
+    assert reversal_reserve(m, quotes, [103, 10], [0, 0]) == 0
+    # The reserve never enters the modeled execution (NAV) cost.
+    assert execution_cost(m, quotes, [103], [-3]) == execution_cost(manifest, quotes, [103], [-3])
+
+
+def test_reserve_creates_a_no_trade_band(manifest, snapshot, quotes):
+    # Additive costs, as in the contest configuration (burn_surplus: false).
+    m = with_policy(manifest.model_copy(update={"allowlist": (103,)}), burn_surplus=False)
+    per_contract = (quotes[103].ask - quotes[103].bid) * 0.6 * 100 + 1.0
+    assert per_contract < 10 < 2 * per_contract  # benefit beats entry, not entry + exit
+    scenarios = hedge_fixture(m)
+    one_way = HedgeOptimizer(m).solve(snapshot, quotes, scenarios, m.initial_nav)
+    assert one_way.status == "OPTIMAL" and one_way.quantities.get(103, 0) < 0
+    assert one_way.reversal_reserve == 0
+    banded = HedgeOptimizer(with_policy(m, option_reversal_reserve=1.0)).solve(
+        snapshot, quotes, scenarios, m.initial_nav
+    )
+    assert banded.status == "OPTIMAL"
+    assert banded.quantities.get(103, 0) == 0 and banded.reversal_reserve == 0
+    assert banded.expected_score == pytest.approx(banded.current_score)
