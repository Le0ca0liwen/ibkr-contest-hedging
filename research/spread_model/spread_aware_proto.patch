+def test_reserve_is_charged_on_the_planned_trade_and_on_its_remainder(manifest, snapshot, quotes):
+    m = with_policy(manifest.model_copy(update={"allowlist": (103,)}), burn_surplus=False)
+    scenarios = hedge_fixture(m)
+    small = with_policy(m, option_reversal_reserve=0.2)
+    target = HedgeOptimizer(small).solve(snapshot, quotes, scenarios, m.initial_nav)
+    sold = target.quantities.get(103, 0)
+    assert sold < 0
+    assert target.reversal_reserve == pytest.approx(reversal_reserve(small, quotes, [103], [sold]))
+    assert target.components["reversal_reserve"] == pytest.approx(target.reversal_reserve)
+    # Plan re-validation charges the reserve on what is still to trade (here: all of it).
+    evaluated = HedgeOptimizer(small).evaluate_target(snapshot, quotes, scenarios, target, m.initial_nav, 1e6)
+    assert evaluated.reversal_reserve == pytest.approx(target.reversal_reserve)
+    exposure_only = HedgeOptimizer(small).evaluate_target(
+        snapshot, quotes, scenarios, target, m.initial_nav, 1e6, include_costs=False
+    )
+    assert exposure_only.reversal_reserve == 0
