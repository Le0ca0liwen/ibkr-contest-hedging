+    _SESSIONS = 4096
+
+    def _session(self, c, at, european, start, end, remaining):
+        """Reusable QuantLib option for a contract/valuation time without cash dividends.
+
+        Scenarios reprice the same contract at the same instant thousands of times with only spot,
+        volatility and rate changing; those three are mutable quotes, so the objects (and the engine)
+        are built once. The result equals the one-shot construction: same inputs, same engine.
+        Contracts with dividends keep the one-shot path (their schedule depends on the horizon).
+        Called with _QL_LOCK held.
+        """
+        if self.manifest.dividends.get(c.symbol):
+            return None
+        key = (c.symbol, c.expiry, c.strike, c.right, european, at)
+        cache = self._sessions
+        hit = cache.get(key)
+        if hit is not None:
+            return hit
+        represented = ql.Actual365Fixed().yearFraction(start, end)
+        ratio = remaining / represented
+        day_count = ql.Actual365Fixed()
+        spot_quote, rate_quote = ql.SimpleQuote(1.0), ql.SimpleQuote(0.0)
+        vol_quote = ql.SimpleQuote(0.2)
+        rate = ql.YieldTermStructureHandle(ql.FlatForward(start, ql.QuoteHandle(rate_quote), day_count))
+        yield_rate = self.manifest.dividend_yields.get(c.symbol, 0)
+        dividends = ql.YieldTermStructureHandle(ql.FlatForward(start, yield_rate * ratio, day_count))
+        vol = ql.BlackVolTermStructureHandle(
+            ql.BlackConstantVol(start, ql.NullCalendar(), ql.QuoteHandle(vol_quote), day_count)
+        )
+        process = ql.BlackScholesMertonProcess(ql.QuoteHandle(spot_quote), dividends, rate, vol)
+        exercise = ql.EuropeanExercise(end) if european else ql.AmericanExercise(start, end)
+        option = ql.VanillaOption(
+            ql.PlainVanillaPayoff(ql.Option.Call if c.right == "C" else ql.Option.Put, c.strike), exercise
+        )
+        option.setPricingEngine(
+            ql.AnalyticEuropeanEngine(process) if european else ql.BjerksundStenslandApproximationEngine(process)
+        )
+        if len(cache) >= self._SESSIONS:
+            cache.clear()
+        cache[key] = (spot_quote, rate_quote, vol_quote, option, ratio)
+        return cache[key]
+
