+"""Minimal affine-expression layer that builds the optimizer's MILP for HiGHS directly (no CVXPY).
+
+It mirrors the subset of CVXPY used by HedgeOptimizer._solve: integer/boolean/nonneg variables,
+affine arithmetic with numpy broadcasting, hstack/sum/multiply/indexing, and |x| through the epigraph
+CVXPY's abs canonicalizer produces (valid only in DCP-convex positions: minimized with nonnegative
+weights, or bounded above).
+
+The compiled model reproduces CVXPY 1.9's HiGHS input exactly, column and row order included:
+columns follow the first appearance of each variable in the canonicalized problem (objective, then
+each constraint preceded by its abs epigraph constraints), and rows put equalities before
+inequalities, each in constraint order. HiGHS therefore receives the same LP it would get through
+CVXPY, which keeps branch-and-bound paths (and so returned hedges) unchanged.
+
+Expressions are dense coefficient matrices over the model's columns; models here have a few hundred
+columns and rows, so dense arithmetic is cheaper than sparse bookkeeping.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+from scipy import sparse
+
+
+def _unique(items):
+    return tuple(dict.fromkeys(items))
+
+
+class Expr:
+    """Affine expression A @ x + b; `shape` is () for scalars or (m,) for vectors.
+
+    `vars` lists the variable ids in CVXPY's traversal order (abs nodes contribute their epigraph
+    variable) and `aux` the abs epigraphs in canonicalization order.
+    """
+
+    __array_ufunc__ = None  # make ndarray @ Expr / ndarray * Expr defer to our reflected operators
+    __slots__ = ("model", "A", "b", "shape", "vars", "aux")
+
+    def __init__(self, model, A, b, shape, vars=(), aux=()):
+        self.model, self.A, self.b, self.shape, self.vars, self.aux = model, A, b, shape, vars, aux
+
+    @property
+    def size(self):
+        return 1 if self.shape == () else self.shape[0]
+
+    def _coef(self, width):
+        A = self.A
+        if A.shape[1] < width:
+            A = np.hstack([A, np.zeros((A.shape[0], width - A.shape[1]))])
+        return A
+
+    def _like(self, A, b, shape=None):
+        return Expr(self.model, A, b, self.shape if shape is None else shape, self.vars, self.aux)
+
+    @staticmethod
+    def _lift(model, other):
+        if isinstance(other, Expr):
+            return other
+        value = np.asarray(other, dtype=float)
+        if value.ndim == 0:
+            return Expr(model, np.zeros((1, 0)), value.reshape(1), ())
+        return Expr(model, np.zeros((len(value), 0)), value.astype(float), value.shape)
+
+    def _binary(self, other, sign):
+        other = Expr._lift(self.model, other)
+        width = max(self.A.shape[1], other.A.shape[1])
+        a, b = self._coef(width), other._coef(width)
+        sb, ob, shape = self.b, other.b, self.shape
+        if self.size != other.size:  # scalar broadcast
+            if self.shape == ():
+                a, sb, shape = np.repeat(a, other.size, axis=0), np.repeat(sb, other.size), other.shape
+            else:
+                b, ob = np.repeat(b, self.size, axis=0), np.repeat(ob, self.size)
+        elif self.shape == () and other.shape != ():
+            shape = other.shape
+        return Expr(
+            self.model, a + sign * b, sb + sign * ob, shape, _unique(self.vars + other.vars), self.aux + other.aux
+        )
+
+    def __add__(self, other):
+        return self._binary(other, 1.0)
+
+    def __radd__(self, other):
+        return Expr._lift(self.model, other)._binary(self, 1.0)
+
+    def __sub__(self, other):
+        return self._binary(other, -1.0)
+
+    def __rsub__(self, other):
+        return Expr._lift(self.model, other)._binary(self, -1.0)
+
+    def __neg__(self):
+        return self._like(-self.A, -self.b)
+
+    def __mul__(self, other):
+        if isinstance(other, Expr):
+            raise TypeError("Nonlinear product")
+        value = np.asarray(other, dtype=float)
+        if value.ndim == 0:
+            return self._like(self.A * float(value), self.b * float(value))
+        return multiply(value, self)
+
+    __rmul__ = __mul__
+
+    def __truediv__(self, other):
+        return self * (1.0 / float(other))
+
+    def __rmatmul__(self, other):
+        matrix = np.asarray(other, dtype=float)
+        # Constant parts accumulate left to right over nonzero entries, like CVXPY's sparse backend
+        # (numpy's pairwise dot would differ from CVXPY's offsets in the last bits).
+        offset = np.zeros(matrix.shape[:-1])
+        for k in np.flatnonzero(self.b):
+            offset += matrix[..., k] * self.b[k]
+        if matrix.ndim == 1:
+            return self._like((matrix @ self.A)[None, :], np.atleast_1d(offset), ())
+        return self._like(matrix @ self.A, offset, (matrix.shape[0],))
+
+    def __getitem__(self, key):
+        if self.shape == ():
+            raise IndexError("Scalar expression")
+        if isinstance(key, (int, np.integer)):
+            return self._like(self.A[key : key + 1], self.b[key : key + 1], ())
+        key = np.asarray(key, dtype=int)
+        return self._like(self.A[key], self.b[key], (len(key),))
+
+    # CVXPY: a <= b is Inequality(a, b); a >= b is Inequality(b, a); a == b is Equality(a, b).
+    def __le__(self, other):
+        return Constraint.inequality(self, Expr._lift(self.model, other))
+
+    def __ge__(self, other):
+        return Constraint.inequality(Expr._lift(self.model, other), self)
+
+    def __eq__(self, other):  # noqa: D105 - constraint builder, like CVXPY
+        other = Expr._lift(self.model, other)
+        return Constraint(self - other, True, self.vars + other.vars, self.aux + other.aux)
+
+    __hash__ = None
+
+    @property
+    def value(self):
+        x = self.model.values
+        if x is None:
+            return None
+        out = self._coef(len(x)) @ x + self.b
+        return float(out[0]) if self.shape == () else out
+
+
+class Constraint:
+    """lhs - rhs <= 0 (inequality) or == 0, with CVXPY's variable/epigraph order."""
+
+    __slots__ = ("expr", "equality", "vars", "aux")
+
+    def __init__(self, expr, equality, vars, aux):
+        self.expr, self.equality, self.vars, self.aux = expr, equality, vars, aux
+
+    @staticmethod
+    def inequality(lhs, rhs):
+        return Constraint(lhs - rhs, False, lhs.vars + rhs.vars, lhs.aux + rhs.aux)
+
+
+class Model:
+    def __init__(self):
+        self.lower, self.upper, self.integer = [], [], []
+        self.variables = []  # (first column, size)
+        self.constraints = []
+        self.abs_groups = []  # (epigraph variable id, source expression)
+        self.values = None  # semantic column values after a solve (creation order, full width)
+        self.user_scalars = 0
+        self.user_integers = 0
+
+    @property
+    def width(self):
+        return len(self.lower)
+
+    def variable(self, size=None, integer=False, boolean=False, nonneg=False, _user=True):
+        count = 1 if size is None else size
+        start = self.width
+        self.lower += [0.0 if (nonneg or boolean) else -np.inf] * count
+        self.upper += [1.0 if boolean else np.inf] * count
+        self.integer += [integer or boolean] * count
+        if _user:
+            self.user_scalars += count
+            self.user_integers += count if (integer or boolean) else 0
+        vid = len(self.variables)
+        self.variables.append((start, count))
+        A = np.zeros((count, start + count))
+        A[np.arange(count), start + np.arange(count)] = 1.0
+        return Expr(self, A, np.zeros(count), () if size is None else (count,), (vid,))
+
+    def add(self, constraints):
+        if isinstance(constraints, Constraint):
+            constraints = [constraints]
+        self.constraints.extend(constraints)
+
+    def abs(self, expr):
+        """|expr| as a free epigraph t with t >= expr, t >= -expr (CVXPY's abs_canon)."""
+        t = self.variable(expr.size if expr.shape else None, _user=False)
+        group = len(self.abs_groups)
+        self.abs_groups.append((t.vars[0], expr))
+        t.aux = expr.aux + (group,)
+        return t
+
+    def compile(self, objectives):
+        """Column-wise HiGHS arrays in CVXPY's order; `rows[k]` maps constraint k to its first row."""
+        width = self.width
+        sequence = []  # canonicalized constraints: (expr, equality, vars, owner constraint or None)
+        order = [v for e in objectives for v in e.vars]
+        emitted = set()
+        for k, c in enumerate(self.constraints):
+            for g in _unique(c.aux):
+                if g in emitted:
+                    continue
+                emitted.add(g)
+                tid, x = self.abs_groups[g]
+                start, size = self.variables[tid]
+                t = Expr(self, np.eye(size, start + size, start), np.zeros(size), x.shape, (tid,))
+                for lhs in (x, -x):  # t >= x, t >= -x: Inequality(x, t), Inequality(-x, t)
+                    sequence.append((lhs - t, False, lhs.vars + t.vars, None))
+            sequence.append((c.expr, c.equality, c.vars, k))
+        for _, _, vars, _ in sequence:
+            order.extend(vars)
+        order = _unique(order)
+        columns = np.concatenate(
+            [np.arange(self.variables[v][0], self.variables[v][0] + self.variables[v][1]) for v in order]
+        )
+        self.columns = columns
+        blocks, upper, lower, rows, row = [], [], [], {}, 0
+        for equality in (True, False):
+            for expr, eq, _, owner in sequence:
+                if eq != equality:
+                    continue
+                if owner is not None:
+                    rows[owner] = row
+                blocks.append(expr._coef(width)[:, columns])
+                upper.append(-expr.b)
+                lower.append(-expr.b if eq else np.full(expr.size, -np.inf))
+                row += expr.size
+        objective = [e._coef(width)[0, columns] for e in objectives]
+        return {
+            "A": sparse.csc_matrix(np.vstack(blocks)),
+            "row_lower": np.concatenate(lower),
+            "row_upper": np.concatenate(upper),
+            "col_lower": np.array(self.lower)[columns],
+            "col_upper": np.array(self.upper)[columns],
+            "integer": np.array(self.integer)[columns],
+            "objective": objective,
+            "offsets": [float(e.b[0]) for e in objectives],
+            "rows": rows,
+        }
+
+    def set_values(self, x):
+        """Store solver columns (compiled order), replacing epigraph columns by the |source| they model."""
+        full = np.zeros(self.width)
+        full[self.columns] = x
+        for tid, source in self.abs_groups:
+            start, size = self.variables[tid]
+            full[start : start + size] = np.abs(source._coef(self.width) @ full + source.b)
+        self.values = full
+
+
+def hstack(items, model):
+    parts = [Expr._lift(model, item) for item in items]
+    width = max(p.A.shape[1] for p in parts)
+    return Expr(
+        model,
+        np.vstack([p._coef(width) for p in parts]),
+        np.concatenate([np.atleast_1d(p.b) for p in parts]),
+        (sum(p.size for p in parts),),
+        _unique(v for p in parts for v in p.vars),
+        tuple(g for p in parts for g in p.aux),
+    )
+
+
+def total(expr):
+    return expr._like(expr.A.sum(axis=0, keepdims=True), np.atleast_1d(expr.b.sum()), ())
+
+
+def multiply(array, expr):
+    array = np.broadcast_to(np.asarray(array, dtype=float), (expr.size,))
+    return expr._like(expr.A * array[:, None], expr.b * array)
