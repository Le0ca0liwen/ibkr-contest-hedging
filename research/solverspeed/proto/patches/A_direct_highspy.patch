+
+    def solve(self, weight, options):
+        data, weight = self.data, np.asarray(weight, dtype=float)
+        cost = sum(w * row for w, row in zip(weight, data["objective"], strict=True))
+        offset = float(weight @ np.array(data["offsets"]))
+        model = highspy.HighsModel()
